---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatDate,
  formatLabel,
  isPublishedWork,
  isPublishedWriting,
  sortWork,
  sortWritingNewestFirst,
} from "../lib/content";

const featuredWriting = (await getCollection("writing", isPublishedWriting))
  .filter(({ data }) => data.featured)
  .sort(sortWritingNewestFirst)
  .slice(0, 3);

const featuredWork = (await getCollection("work", isPublishedWork))
  .filter(({ data }) => data.featured)
  .sort(sortWork)
  .slice(0, 3);

const currentFocus = [
  "Building Aeonmarked, a systems-heavy sandbox roguelike in Godot and C#.",
  "Exploring practical agent workflows, software architecture, and personal tooling.",
  "Turning this site into a useful place for notes, experiments, and work in progress.",
];
---

<BaseLayout description="Luke Bayliss is a Melbourne software engineer writing about software architecture, systems, experiments, and work in progress.">
  <section class="hero site-container">
    <div class="hero__copy">
      <p class="eyebrow">Hello, I’m Luke.</p>
      <h1>I build software, explore systems, and write down what proves useful.</h1>
      <p class="hero__summary">
        I’m a software engineer in Melbourne. This is my place for technical notes, interactive ideas,
        project work, and the occasional changed opinion.
      </p>
      <div class="hero__actions">
        <a class="button-primary" href="/writing/">Read the writing <span aria-hidden="true">→</span></a>
        <a class="button-secondary" href="/about/">More about me</a>
      </div>
    </div>

    <aside class="focus-note" aria-labelledby="current-focus-title">
      <div class="focus-note__heading">
        <p class="eyebrow">Right now</p>
        <span class="focus-note__pulse" aria-hidden="true"></span>
      </div>
      <h2 id="current-focus-title">Current focus</h2>
      <ul>
        {currentFocus.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </section>

  <section class="section-rule home-section site-container" aria-labelledby="writing-title">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Writing</p>
        <h2 id="writing-title">Notes with room to grow</h2>
      </div>
      <p>
        Short discoveries, developed essays, build logs, and small interactive labs. A useful idea does
        not need to pretend it is a white paper.
      </p>
    </div>

    {featuredWriting.length === 0 ? (
      <div class="empty-feature">
        <p>No featured writing yet.</p>
        <a class="text-link" href="/writing/">Visit Writing <span aria-hidden="true">→</span></a>
      </div>
    ) : (
      <div class="featured-writing">
        {featuredWriting.map((entry) => (
          <article class="writing-feature">
            <div class="writing-feature__meta">
              <span>{formatLabel(entry.data.format)}</span>
              <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>
            </div>
            <div>
              <h3><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
            </div>
            <a class="writing-feature__arrow" href={`/writing/${entry.id}/`} aria-label={`Read ${entry.data.title}`}>
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    )}
    <a class="text-link section-link" href="/writing/">All writing <span aria-hidden="true">→</span></a>
  </section>

  <section class="section-rule home-section site-container" aria-labelledby="work-title">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title">Things I’m making and maintaining</h2>
      </div>
      <p>A small, intentional selection—not a feed of every repository I have ever touched.</p>
    </div>

    <div class="work-list">
      {featuredWork.map((entry) => (
        <article class="work-row">
          <div class="work-row__meta">
            <span>{formatLabel(entry.data.category)}</span>
            <span>{formatLabel(entry.data.status)}</span>
          </div>
          <div>
            <h3><a href={`/work/${entry.id}/`}>{entry.data.title}</a></h3>
            <p>{entry.data.summary}</p>
          </div>
          <a class="work-row__arrow" href={`/work/${entry.id}/`} aria-label={`View ${entry.data.title}`}>
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <a class="text-link section-link" href="/work/">See selected work <span aria-hidden="true">→</span></a>
  </section>

  <section class="contact-band">
    <div class="site-container contact-band__inner">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Found something worth discussing?</h2>
        <p>Email is the simplest way to reach me. GitHub and LinkedIn are there for context.</p>
      </div>
      <div class="contact-band__actions">
        <a class="button-primary" href="mailto:hello@lukebayliss.com">Send an email</a>
        <a class="button-secondary" href="https://github.com/lpbayliss" rel="me noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 0.75fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: end;
    padding-block: clamp(4.5rem, 10vw, 8.5rem);
  }

  .hero__copy {
    max-width: 49rem;
  }

  .hero h1 {
    max-width: 18ch;
    margin-top: 1rem;
    font-size: clamp(2.6rem, 6vw, 5.4rem);
  }

  .hero__summary {
    max-width: 42rem;
    margin-top: 1.7rem;
    color: var(--site-foreground-muted);
    font-size: clamp(1.08rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.65;
  }

  .hero__actions,
  .contact-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .focus-note {
    border-top: 3px solid var(--site-accent);
    background: var(--site-surface);
    padding: 1.3rem 1.4rem 1.4rem;
  }

  .focus-note__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .focus-note__pulse {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--site-accent);
    box-shadow: 0 0 0 0.28rem color-mix(in srgb, var(--site-accent) 12%, transparent);
  }

  .focus-note h2 {
    margin-top: 0.7rem;
    font-size: 1.35rem;
  }

  .focus-note ul {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.1rem;
    padding-left: 1.1rem;
    color: var(--site-foreground-muted);
    font-size: 0.86rem;
  }

  .focus-note li::marker {
    color: var(--site-accent);
  }

  .home-section {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    gap: 2rem 5rem;
    align-items: end;
  }

  .section-intro h2,
  .contact-band h2 {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .section-intro > p,
  .contact-band p {
    color: var(--site-foreground-muted);
  }

  .empty-feature {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 3rem;
    border-left: 3px solid var(--site-border);
    padding: 1.1rem 0 1.1rem 1.35rem;
  }

  .empty-feature > div {
    max-width: 44rem;
  }

  .empty-feature__label {
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .empty-feature p:last-child {
    color: var(--site-foreground-muted);
  }

  .featured-writing {
    margin-top: 3rem;
    border-top: 1px solid var(--site-border);
  }

  .writing-feature {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1fr) auto;
    gap: 2rem 4rem;
    align-items: start;
    border-bottom: 1px solid var(--site-border);
    padding-block: 2rem;
  }

  .writing-feature__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--site-foreground-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .writing-feature h3,
  .work-row h3 {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
  }

  .writing-feature h3 a,
  .work-row h3 a {
    text-decoration: none;
  }

  .writing-feature h3 a:hover,
  .work-row h3 a:hover {
    color: var(--site-accent-strong);
  }

  .writing-feature p {
    max-width: 48rem;
    margin-top: 0.55rem;
    color: var(--site-foreground-muted);
  }

  .writing-feature__arrow,
  .work-row__arrow {
    color: var(--site-accent);
    font-size: 1.2rem;
    text-decoration: none;
  }

  .work-list {
    margin-top: 3rem;
    border-top: 1px solid var(--site-border);
  }

  .work-row {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1fr) auto;
    gap: 2rem 4rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--site-border);
  }

  .work-row__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--site-foreground-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .work-row p {
    max-width: 48rem;
    margin-top: 0.55rem;
    color: var(--site-foreground-muted);
  }

  .section-link {
    display: inline-block;
    margin-top: 2rem;
  }

  .contact-band {
    margin-top: 1rem;
    background: var(--site-surface-muted);
  }

  .contact-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem 5rem;
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .contact-band p:not(.eyebrow) {
    max-width: 38rem;
    margin-top: 1rem;
  }

  .contact-band__actions {
    margin-top: 0;
  }

  @media (max-width: 50rem) {
    .hero,
    .section-intro,
    .contact-band__inner {
      grid-template-columns: 1fr;
    }

    .hero {
      align-items: start;
    }

    .focus-note {
      max-width: 34rem;
    }

    .contact-band__actions {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 38rem) {
    .hero {
      gap: 2.8rem;
      padding-block: 3.7rem;
    }

    .hero h1 {
      font-size: clamp(2.35rem, 12vw, 3.3rem);
    }

    .empty-feature,
    .writing-feature,
    .work-row {
      align-items: start;
      grid-template-columns: 1fr;
      flex-direction: column;
    }

    .writing-feature,
    .work-row {
      gap: 0.9rem;
    }

    .writing-feature__meta,
    .work-row__meta {
      flex-direction: row;
      gap: 0.75rem;
    }
  }
</style>
