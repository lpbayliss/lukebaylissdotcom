---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import IconLink from "../components/IconLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatDate,
  formatLabel,
  isPublishedWork,
  isPublishedWriting,
  sortWork,
  sortWritingNewestFirst,
} from "../lib/content";

const featuredWriting = (await getCollection("writing", isPublishedWriting))
  .filter(({ data }) => data.featured)
  .sort(sortWritingNewestFirst)
  .slice(0, 2);

const featuredWork = (await getCollection("work", isPublishedWork))
  .filter(({ data }) => data.featured)
  .sort(sortWork)
  .slice(0, 2);
---

<BaseLayout description="Luke Bayliss is a Melbourne software engineer writing about software architecture, systems, experiments, and work in progress.">
  <section class="hero site-container">
    <div class="hero__copy">
      <p class="eyebrow">Hello, I’m Luke.</p>
      <h1>I build software and useful systems.</h1>
      <p class="hero__summary">
        Software engineer in Melbourne, working mostly with TypeScript, Node, Go, and .NET. This is where
        I share notes, projects, and experiments.
      </p>
      <div class="hero__actions">
        <a class="button-primary" href="/writing/">
          Read the writing
          <Icon name="arrow-right" />
        </a>
        <div class="hero__links" aria-label="Contact and profiles">
          <IconLink href="mailto:hello@lukebayliss.com" icon="email" label="Email" iconOnly />
          <IconLink href="https://github.com/lpbayliss" icon="github" label="GitHub" iconOnly me />
          <IconLink href="https://www.linkedin.com/in/lpbayliss/" icon="linkedin" label="LinkedIn" iconOnly me />
        </div>
      </div>
    </div>

    <aside id="current-focus" class="focus-note" aria-labelledby="current-focus-title">
      <p class="eyebrow">Right now</p>
      <h2 id="current-focus-title">Current focus</h2>
      <p>Building Aeonmarked, a systems-heavy sandbox roguelike in Godot and C#.</p>
    </aside>
  </section>

  <section id="selected-writing" class="section-rule home-section site-container" aria-labelledby="writing-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Writing</p>
        <h2 id="writing-title">Selected writing</h2>
      </div>
      <a class="text-link" href="/writing/">All writing <span aria-hidden="true">→</span></a>
    </div>

    {featuredWriting.length === 0 ? (
      <div class="empty-feature">
        <p>No featured writing yet.</p>
        <a class="text-link" href="/writing/">Visit Writing <span aria-hidden="true">→</span></a>
      </div>
    ) : (
      <div class="feature-list">
        {featuredWriting.map((entry) => (
          <article class="writing-feature">
            <div class="writing-feature__meta">
              <span>{formatLabel(entry.data.format)}</span>
              <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>
            </div>
            <h3><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h3>
            <a class="feature-arrow" href={`/writing/${entry.id}/`} aria-label={`Read ${entry.data.title}`}>
              <Icon name="arrow-right" />
            </a>
          </article>
        ))}
      </div>
    )}
  </section>

  <section id="selected-work" class="section-rule home-section site-container" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Work</p>
        <h2 id="work-title">Selected work</h2>
      </div>
      <a class="text-link" href="/work/">All work <span aria-hidden="true">→</span></a>
    </div>

    {featuredWork.length === 0 ? (
      <div class="empty-feature">
        <p>No featured work yet.</p>
        <a class="text-link" href="/work/">Visit Work <span aria-hidden="true">→</span></a>
      </div>
    ) : (
      <div class="feature-list">
        {featuredWork.map((entry) => (
          <article class="work-row">
            <div class="work-row__meta">
              <span>{formatLabel(entry.data.category)}</span>
              <span>{formatLabel(entry.data.status)}</span>
            </div>
            <div class="work-row__content">
              <h3><a href={`/work/${entry.id}/`}>{entry.data.title}</a></h3>
              <p class="work-row__summary">{entry.data.summary}</p>
            </div>
            <a class="feature-arrow" href={`/work/${entry.id}/`} aria-label={`View ${entry.data.title}`}>
              <Icon name="arrow-right" />
            </a>
          </article>
        ))}
      </div>
    )}
  </section>

  <section id="contact" class="section-rule contact-row site-container" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">Elsewhere</p>
      <h2 id="contact-title">Contact</h2>
    </div>
    <div class="contact-row__links">
      <IconLink href="mailto:hello@lukebayliss.com" icon="email" label="Email" />
      <IconLink href="https://github.com/lpbayliss" icon="github" label="GitHub" me />
      <IconLink href="https://www.linkedin.com/in/lpbayliss/" icon="linkedin" label="LinkedIn" me />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.65fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .hero__copy {
    max-width: 48rem;
  }

  .hero h1 {
    max-width: 15ch;
    margin-top: 0.75rem;
    font-size: clamp(2.65rem, 5.5vw, 4.6rem);
  }

  .hero__summary {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: var(--site-foreground-muted);
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    line-height: 1.6;
  }

  .hero__actions,
  .hero__links,
  .contact-row__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__actions {
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .hero__links,
  .contact-row__links {
    gap: 0.15rem;
  }

  .focus-note {
    border-left: 3px solid var(--site-accent);
    padding: 0.35rem 0 0.35rem 1.25rem;
  }

  .focus-note h2 {
    margin-top: 0.45rem;
    font-size: 1.25rem;
  }

  .focus-note > p:last-child {
    margin-top: 0.65rem;
    color: var(--site-foreground-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .home-section {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .section-heading,
  .contact-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .section-heading h2,
  .contact-row h2 {
    margin-top: 0.4rem;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
  }

  .feature-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--site-border);
  }

  .writing-feature,
  .work-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.34fr) minmax(0, 1fr) auto;
    gap: 1rem 2.5rem;
    align-items: center;
    border-bottom: 1px solid var(--site-border);
    padding-block: 1.25rem;
  }

  .writing-feature__meta,
  .work-row__meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--site-foreground-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .writing-feature h3,
  .work-row h3 {
    font-size: clamp(1.15rem, 1rem + 0.55vw, 1.45rem);
  }

  .writing-feature h3 a,
  .work-row h3 a,
  .feature-arrow {
    text-decoration: none;
  }

  .writing-feature h3 a:hover,
  .work-row h3 a:hover,
  .feature-arrow:hover {
    color: var(--site-accent-strong);
  }

  .work-row__summary {
    max-width: 48rem;
    margin-top: 0.35rem;
    color: var(--site-foreground-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .feature-arrow {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--site-accent);
  }

  .empty-feature {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    border-left: 3px solid var(--site-border);
    padding: 0.75rem 0 0.75rem 1rem;
  }

  .contact-row {
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 50rem) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .focus-note {
      max-width: 36rem;
    }
  }

  @media (max-width: 38rem) {
    .hero {
      gap: 2.25rem;
      padding-block: 2.75rem;
    }

    .hero h1 {
      font-size: clamp(2.45rem, 11.5vw, 3.25rem);
    }

    .section-heading,
    .contact-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .writing-feature,
    .work-row {
      grid-template-columns: 1fr auto;
      gap: 0.5rem 1rem;
    }

    .writing-feature__meta,
    .work-row__meta {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 0.75rem;
    }

    .feature-arrow {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
