---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Writing" description="Technical notes, essays, build logs, and interactive labs by Luke Bayliss.">
  <section class="site-container page-intro">
    <p class="eyebrow">Writing</p>
    <h1>Notes, explanations, and things still being figured out.</h1>
    <p>
      This section is being reorganised around notes, essays, labs, build logs, and case studies. The
      first pieces for the new format are on the way.
    </p>
    <a class="text-link" href="/rss.xml">Subscribe by RSS <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .page-intro {
    max-width: 58rem;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  h1 {
    max-width: 18ch;
    margin-top: 1rem;
    font-size: clamp(2.5rem, 6vw, 4.8rem);
  }

  p:not(.eyebrow) {
    max-width: 48rem;
    margin-block: 1.5rem 2rem;
    color: var(--site-foreground-muted);
    font-size: 1.1rem;
  }
</style>
