---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Work" description="Selected software projects, experiments, and technical work by Luke Bayliss.">
  <section class="site-container page-intro">
    <p class="eyebrow">Work</p>
    <h1>A considered selection, not a repository firehose.</h1>
    <p>
      The work archive is being rebuilt around real project context, decisions, constraints, and useful
      artefacts. Aeonmarked and this site will be the first entries.
    </p>
    <a class="text-link" href="https://github.com/lpbayliss" rel="me noreferrer">
      Browse GitHub for now <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>

<style>
  .page-intro {
    max-width: 58rem;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  h1 {
    max-width: 18ch;
    margin-top: 1rem;
    font-size: clamp(2.5rem, 6vw, 4.8rem);
  }

  p:not(.eyebrow) {
    max-width: 48rem;
    margin-block: 1.5rem 2rem;
    color: var(--site-foreground-muted);
    font-size: 1.1rem;
  }
</style>
