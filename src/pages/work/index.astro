---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatLabel, isPublishedWork, sortWork } from "../../lib/content";

const entries = (await getCollection("work", isPublishedWork)).sort(sortWork);
---

<BaseLayout title="Work" description="Selected software projects, experiments, and technical work by Luke Bayliss.">
  <section class="site-container work-intro">
    <p class="eyebrow">Work</p>
    <h1>A considered selection, not a repository firehose.</h1>
    <p>
      Independent projects and experiments with enough context to explain what they are, why they
      exist, and what they are teaching me.
    </p>
  </section>

  <section class="section-rule site-container work-list" aria-label="Selected work">
    {entries.map((entry) => (
      <article class="work-entry">
        <div class="work-entry__meta">
          <span>{formatLabel(entry.data.category)}</span>
          <span>{formatLabel(entry.data.status)}</span>
        </div>
        <div>
          <h2><a href={`/work/${entry.id}/`}>{entry.data.title}</a></h2>
          <p>{entry.data.summary}</p>
          {entry.data.technologies.length > 0 && (
            <ul aria-label="Technologies">
              {entry.data.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
          )}
        </div>
        <a class="work-entry__arrow" href={`/work/${entry.id}/`} aria-label={`View ${entry.data.title}`}>
          <span aria-hidden="true">→</span>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .work-intro {
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .work-intro h1 {
    max-width: 18ch;
    margin-top: 1rem;
    font-size: clamp(2.55rem, 6vw, 5rem);
  }

  .work-intro > p:not(.eyebrow) {
    max-width: 46rem;
    margin-top: 1.4rem;
    color: var(--site-foreground-muted);
    font-size: 1.08rem;
  }

  .work-list {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 10vw, 8rem);
  }

  .work-entry {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr) auto;
    gap: 1.5rem 3rem;
    align-items: start;
    border-bottom: 1px solid var(--site-border);
    padding-block: 2.2rem;
  }

  .work-entry:first-child {
    padding-top: 0;
  }

  .work-entry__meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--site-foreground-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .work-entry h2 {
    font-size: clamp(1.45rem, 2.8vw, 2rem);
  }

  .work-entry h2 a {
    text-decoration: none;
  }

  .work-entry h2 a:hover {
    color: var(--site-accent-strong);
  }

  .work-entry p {
    max-width: 48rem;
    margin-top: 0.55rem;
    color: var(--site-foreground-muted);
  }

  .work-entry ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .work-entry li {
    border: 1px solid var(--site-border);
    border-radius: 999px;
    color: var(--site-foreground-muted);
    padding: 0.18rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .work-entry__arrow {
    color: var(--site-accent);
    font-size: 1.25rem;
    text-decoration: none;
  }

  @media (max-width: 42rem) {
    .work-entry {
      grid-template-columns: 1fr auto;
      gap: 0.9rem 1rem;
    }

    .work-entry__meta {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 0.75rem;
    }
  }
</style>
