---
interface Props {
  name: "arrow-right" | "email" | "external" | "github" | "linkedin" | "rss";
  size?: number;
}

const { name, size = 18 } = Astro.props as Props;
---

<svg
  aria-hidden="true"
  class="link-icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.8"
>
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "email" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === "external" && (
    <>
      <path d="M14 5h5v5" />
      <path d="m19 5-8 8" />
      <path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
    </>
  )}
  {name === "github" && (
    <path d="M15 22v-3.9c.04-1-.35-1.75-.9-2.15 3-.34 6.15-1.48 6.15-6.7A5.2 5.2 0 0 0 18.85 5.6 4.9 4.9 0 0 0 18.7 2S17.6 1.65 15 3.4a12.7 12.7 0 0 0-6 0C6.4 1.65 5.3 2 5.3 2a4.9 4.9 0 0 0-.15 3.6 5.2 5.2 0 0 0-1.4 3.65c0 5.2 3.15 6.36 6.15 6.7-.48.35-.82.9-.92 1.55-.1.65-.04 1.7-.04 2.5 0 .8-.54 1.8-1.94 1.5-1.4-.3-2.16-2.7-3.66-2.6" />
  )}
  {name === "linkedin" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <path d="M8 10v7M8 7v.01M12 17v-4a3 3 0 0 1 6 0v4M12 10v7" />
    </>
  )}
  {name === "rss" && (
    <>
      <circle cx="6" cy="18" r="1" fill="currentColor" stroke="none" />
      <path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" />
    </>
  )}
</svg>

<style>
  .link-icon {
    display: block;
    flex: 0 0 auto;
  }
</style>
