---
import IconLink from "./IconLink.astro";
---

<footer class="site-footer">
  <div class="site-container site-footer__inner">
    <p class="site-footer__identity">© {new Date().getFullYear()} Luke Bayliss</p>

    <nav aria-label="Footer navigation">
      <ul class="site-footer__links">
        <li><a href="/writing/">Writing</a></li>
        <li><a href="/work/">Work</a></li>
        <li><a href="/about/">About</a></li>
        <li><IconLink href="/rss.xml" icon="rss" label="RSS" /></li>
        <li><IconLink href="https://github.com/lpbayliss" icon="github" label="GitHub" me /></li>
        <li><IconLink href="https://www.linkedin.com/in/lpbayliss/" icon="linkedin" label="LinkedIn" me /></li>
        <li><IconLink href="mailto:hello@lukebayliss.com" icon="email" label="Email" /></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--site-border);
    padding-block: 1.25rem;
  }

  .site-footer__inner,
  .site-footer__links {
    display: flex;
    align-items: center;
  }

  .site-footer__inner {
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .site-footer__identity {
    flex: 0 0 auto;
    color: var(--site-foreground-muted);
    font-size: 0.875rem;
  }

  .site-footer__links {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.1rem 0.35rem;
    list-style: none;
  }

  .site-footer__links > li > a:not(.icon-link) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: 0.35rem;
    color: var(--site-foreground-muted);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 0.55rem;
    text-decoration: none;
  }

  .site-footer__links > li > a:hover {
    color: var(--site-accent-strong);
    background: var(--site-surface-muted);
  }

  @media (max-width: 46rem) {
    .site-footer__inner {
      align-items: flex-start;
      flex-direction: column-reverse;
    }

    .site-footer__links {
      justify-content: flex-start;
    }
  }
</style>
