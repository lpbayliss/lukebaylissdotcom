---
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const {
  title,
  description = "Luke Bayliss writes about software engineering, systems, experiments, and useful things learned along the way.",
  canonicalUrl: canonicalOverride,
  ogImage,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props as Props;

const siteTitle = "Luke Bayliss";
const pageTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} — Software engineer`;
const canonicalUrl =
  canonicalOverride ||
  (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined);
const defaultOgImage = Astro.site
  ? new URL(
      `/og-image.png?title=${encodeURIComponent(title || siteTitle)}&description=${encodeURIComponent(description)}&type=${encodeURIComponent(ogType === "article" ? "Writing" : "Personal technical space")}`,
      Astro.site,
    ).toString()
  : undefined;
const finalOgImage = ogImage || defaultOgImage;
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Luke Bayliss",
  url: Astro.site?.toString() || "https://lukebayliss.com",
  homeLocation: {
    "@type": "Place",
    name: "Melbourne, Australia",
  },
  jobTitle: "Software engineer",
  sameAs: ["https://github.com/lpbayliss", "https://www.linkedin.com/in/lpbayliss/"],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem("theme");
          const theme =
            storedTheme === "light" || storedTheme === "dark"
              ? storedTheme
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#f6f3ec" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_AU" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {finalOgImage && <meta property="og:image" content={finalOgImage} />}
    {finalOgImage && <meta property="og:image:alt" content={`${title || siteTitle} — lukebayliss.com`} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {finalOgImage && <meta name="twitter:image" content={finalOgImage} />}
    {finalOgImage && <meta name="twitter:image:alt" content={`${title || siteTitle} — lukebayliss.com`} />}

    <link rel="alternate" type="application/rss+xml" title="Luke Bayliss writing" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navigation activePath={Astro.url.pathname} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    border-radius: 0.35rem;
    background: var(--site-foreground);
    color: var(--site-background);
    font-weight: 700;
    padding: 0.65rem 0.9rem;
    text-decoration: none;
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
